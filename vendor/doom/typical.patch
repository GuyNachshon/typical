diff --git a/src/doom/typical_api.c b/src/doom/typical_api.c
new file mode 100644
index 0000000..8124ed9
--- /dev/null
+++ b/src/doom/typical_api.c
@@ -0,0 +1,136 @@
+// typical_api.c — JS-facing state export + input injection for the Typical site.
+// GPL-2, same as the rest of Chocolate Doom.
+#include <emscripten.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "doomstat.h"
+#include "d_event.h"
+#include "d_player.h"
+#include "d_items.h"
+#include "g_game.h"
+#include "m_menu.h"
+#include "p_local.h"
+#include "r_main.h"
+
+#define ANG_TO_DEG(a) ((double)(int32_t)(a) * (360.0 / 4294967296.0))
+#define NEAREST 8
+
+static const char *weapon_names[NUMWEAPONS] = {
+    "fist", "pistol", "shotgun", "chaingun", "rocket", "plasma", "bfg", "chainsaw", "supershotgun"};
+
+static const char *MonsterName(mobjtype_t t)
+{
+    switch (t)
+    {
+        case MT_POSSESSED: return "zombieman";
+        case MT_SHOTGUY:   return "shotgun_guy";
+        case MT_TROOP:     return "imp";
+        case MT_SERGEANT:  return "demon";
+        case MT_SHADOWS:   return "spectre";
+        case MT_HEAD:      return "cacodemon";
+        case MT_BRUISER:   return "baron";
+        case MT_SKULL:     return "lost_soul";
+        case MT_SPIDER:    return "spider_mastermind";
+        case MT_CYBORG:    return "cyberdemon";
+        default:           return "monster";
+    }
+}
+
+// Same test as P_TryMove but without moving, and with pickups disabled so the
+// probe can't grab items. P_CheckPosition only looks at the bbox at the target,
+// so probe every 16 units out to dist rather than just the far point.
+static int BlockedAhead(mobj_t *mo, int dist)
+{
+    int flags = mo->flags, d, ok = 1;
+    mo->flags &= ~MF_PICKUP;
+    for (d = 16; d <= dist && ok; d += 16)
+    {
+        fixed_t nx = mo->x + FixedMul(d * FRACUNIT, finecosine[mo->angle >> ANGLETOFINESHIFT]);
+        fixed_t ny = mo->y + FixedMul(d * FRACUNIT, finesine[mo->angle >> ANGLETOFINESHIFT]);
+        ok = P_CheckPosition(mo, nx, ny)
+            && tmceilingz - tmfloorz >= mo->height
+            && tmceilingz - mo->z >= mo->height
+            && tmfloorz - mo->z <= 24 * FRACUNIT;
+    }
+    mo->flags = flags;
+    return !ok;
+}
+
+EMSCRIPTEN_KEEPALIVE
+const char *typical_state_json(void)
+{
+    static char buf[4096];
+    char *p = buf, *end = buf + sizeof(buf);
+    player_t *pl = &players[consoleplayer];
+    mobj_t *mo = pl->mo;
+    int ammotype;
+
+    if (gamestate != GS_LEVEL || !mo)
+    {
+        snprintf(buf, sizeof(buf), "{\"in_level\":false,\"gamestate\":%d,\"menu\":%d}",
+                 (int)gamestate, menuactive ? 1 : 0);
+        return buf;
+    }
+
+    ammotype = weaponinfo[pl->readyweapon].ammo;
+    p += snprintf(p, end - p,
+        "{\"in_level\":true,\"demo\":%s,\"menu\":%d,\"episode\":%d,\"map\":%d,\"tic\":%d,"
+        "\"x\":%.1f,\"y\":%.1f,\"angle\":%.1f,\"health\":%d,\"armor\":%d,"
+        "\"weapon\":\"%s\",\"ammo\":%d,\"kills\":%d,\"total_kills\":%d,"
+        "\"blocked_ahead\":%s,\"monsters\":[",
+        demoplayback ? "true" : "false", menuactive ? 1 : 0, gameepisode, gamemap, leveltime,
+        mo->x / (double)FRACUNIT, mo->y / (double)FRACUNIT, ANG_TO_DEG(mo->angle),
+        pl->health, pl->armorpoints, weapon_names[pl->readyweapon],
+        ammotype == am_noammo ? -1 : pl->ammo[ammotype],
+        pl->killcount, totalkills, BlockedAhead(mo, 64) ? "true" : "false");
+
+    // ponytail: O(n*8) insertion into a small sorted array; fine for Doom's thinker counts.
+    mobj_t *near[NEAREST];
+    double near_d[NEAREST];
+    int n = 0;
+    for (thinker_t *th = thinkercap.next; th != &thinkercap; th = th->next)
+    {
+        if (th->function.acp1 != (actionf_p1)P_MobjThinker) continue;
+        mobj_t *m = (mobj_t *)th;
+        if (!(m->flags & MF_COUNTKILL) || m->health <= 0) continue;
+        double d = P_AproxDistance(m->x - mo->x, m->y - mo->y) / (double)FRACUNIT;
+        if (n == NEAREST && d >= near_d[NEAREST - 1]) continue;
+        int i = n < NEAREST ? n++ : NEAREST - 1;
+        while (i > 0 && near_d[i - 1] > d) { near[i] = near[i - 1]; near_d[i] = near_d[i - 1]; i--; }
+        near[i] = m; near_d[i] = d;
+    }
+    for (int i = 0; i < n; i++)
+    {
+        mobj_t *m = near[i];
+        // Doom angles grow counter-clockwise; flip so positive = right of crosshair.
+        double bearing = -ANG_TO_DEG(R_PointToAngle2(mo->x, mo->y, m->x, m->y) - mo->angle);
+        p += snprintf(p, end - p,
+            "%s{\"type\":\"%s\",\"dist\":%.0f,\"bearing\":%.1f,\"in_crosshair\":%s}",
+            i ? "," : "", MonsterName(m->type), near_d[i], bearing,
+            fabs(bearing) <= 8.0 ? "true" : "false");
+    }
+    snprintf(p, end - p, "]}");
+    return buf;
+}
+
+// Same path I_HandleKeyboardEvent takes for SDL key events (key codes from doomkeys.h).
+EMSCRIPTEN_KEEPALIVE
+void typical_input(int key, int down)
+{
+    event_t ev;
+    memset(&ev, 0, sizeof(ev));
+    ev.type = down ? ev_keydown : ev_keyup;
+    ev.data1 = key;
+    ev.data2 = ev.data3 = (down && key < 128) ? key : 0;
+    D_PostEvent(&ev);
+}
+
+// Start E1M1 the same way the menu does (deferred to the next tic inside the main loop);
+// -warp autostart runs the first tic inline in main() and trips over asyncify.
+EMSCRIPTEN_KEEPALIVE
+void typical_new_game(int skill)
+{
+    G_DeferedInitNew(skill, 1, 1);
+}
